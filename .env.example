# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings -> API). Solo la URL y la clave pública (anon / publishable).
# NUNCA pongas aquí la service_role / secret key: esta app no la necesita.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Asistente con IA (Gemini). Clave de https://aistudio.google.com/apikey
# Va SIN el prefijo VITE_: así solo la usa el servidor (/api/chat) y nunca llega al navegador.
GEMINI_API_KEY=
# Opcional: modelos de Gemini (principal y respaldo si el principal está saturado o falla).
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL_RESPALDO=gemini-3.5-flash
